# ==============================================================================
# PIMS HCP PROFILING APP - PROXYSQL READ/WRITE SPLIT & CONNECTION MULTIPLEXING
# Mitigates MariaDB Database Bottlenecks During Peak Field Profiling Usage
# ==============================================================================

admin_variables = {
    admin_credentials = "admin:PIMS_ProxySQL_Admin_Secure_Pass_2026"
    mysql_ifaces = "0.0.0.0:6032"
    refresh_interval = 2000
}

mysql_variables = {
    threads = 8
    max_connections = 4096
    default_query_delay = 0
    default_query_timeout = 36000000
    have_compress = true
    poll_timeout = 2000
    interfaces = "0.0.0.0:3306"
    default_schema = "_pms_erpn_db"
    stacksize = 1048576
    connect_timeout_server = 3000
    monitor_username = "monitor"
    monitor_password = "Monitor_Secure_Password_2026"
    monitor_history = 600000
    monitor_connect_interval = 10000
    monitor_ping_interval = 5000
    ping_timeout_server = 500
    commands_stats = true
    sessions_sort = true
    connect_retries_on_failure = 5
}

# ------------------------------------------------------------------------------
# MYSQL SERVERS (PRIMARY MASTER VS READ REPLICAS)
# ------------------------------------------------------------------------------
# Hostgroup 10: Primary Writer (Handles INSERT, UPDATE, DELETE, Transactions)
# Hostgroup 20: Read Replicas (Handles SELECT Queries, Searching, Masterlists)
mysql_servers = (
    {
        address = "mariadb_primary"
        port = 3306
        hostgroup = 10
        max_connections = 200
        weight = 100
        comment = "Primary MariaDB Master Node (Writes & Workflows)"
    },
    {
        address = "mariadb_replica_1"
        port = 3306
        hostgroup = 20
        max_connections = 400
        weight = 100
        comment = "Read Replica Node 1 (Fast Search & Read Scaling)"
    },
    {
        address = "mariadb_replica_2"
        port = 3306
        hostgroup = 20
        max_connections = 400
        weight = 100
        comment = "Read Replica Node 2 (Fast Search & Read Scaling)"
    }
)

# ------------------------------------------------------------------------------
# MYSQL USERS (APPLICATIONS CONNECTING VIA PROXYSQL)
# ------------------------------------------------------------------------------
mysql_users = (
    {
        username = "frappe_user"
        password = "Frappe_DB_Cluster_Pass_2026"
        default_hostgroup = 10
        max_connections = 2000
        transaction_persistent = 1
    }
)

# ------------------------------------------------------------------------------
# QUERY ROUTING RULES (AUTOMATIC READ/WRITE SPLITTING)
# ------------------------------------------------------------------------------
mysql_query_rules = (
    # Rule 1: Transactions and locking reads stay on Primary Master
    {
        rule_id = 1
        active = 1
        match_pattern = "^SELECT .* FOR UPDATE$"
        destination_hostgroup = 10
        apply = 1
    },
    # Rule 2: Explicit transactions stay on Master
    {
        rule_id = 2
        active = 1
        match_pattern = "^(INSERT|UPDATE|DELETE|REPLACE|CREATE|DROP|ALTER|START TRANSACTION|COMMIT|ROLLBACK)"
        destination_hostgroup = 10
        apply = 1
    },
    # Rule 3: Heavy masterlist searches & read queries route to Read Replicas
    {
        rule_id = 10
        active = 1
        match_pattern = "^SELECT .* FROM `tabHCP`.*"
        destination_hostgroup = 20
        apply = 1
    },
    {
        rule_id = 11
        active = 1
        match_pattern = "^SELECT .* FROM `tabHCP Account`.*"
        destination_hostgroup = 20
        apply = 1
    },
    {
        rule_id = 12
        active = 1
        match_pattern = "^SELECT .* FROM `tabInstitution`.*"
        destination_hostgroup = 20
        apply = 1
    },
    {
        rule_id = 13
        active = 1
        match_pattern = "^SELECT .* FROM `tabTerritory`.*"
        destination_hostgroup = 20
        apply = 1
    },
    # Rule 4: All other generic SELECT statements route to Read Replicas
    {
        rule_id = 100
        active = 1
        match_pattern = "^SELECT "
        destination_hostgroup = 20
        apply = 1
    }
)
